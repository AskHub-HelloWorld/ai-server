APP_NAME=AskHub AI Server
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# AWS Bedrock (미설정 시 mock 모드로 동작)
AWS_REGION=ap-southeast-2
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
USE_BEDROCK=false  # EC2 IAM Role 환경에서 true로 설정

# Database (단일 EC2 공통 PostgreSQL 중 ai schema만 사용)
DB_PASSWORD=askhub
DATABASE_URL=postgresql+psycopg://askhub:askhub@postgres:5432/askhub
DB_SCHEMA=ai

# File storage (MVP: Docker volume)
UPLOAD_DIR=/app/uploads

BACKEND_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
