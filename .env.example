APP_NAME=AskHub AI Server
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# AWS Bedrock. The service fails fast when Bedrock credentials are not available.
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# RAG retrieval settings
RAG_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_TOKENS=4000

# Backend-owned PostgreSQL container/network.
POSTGRES_HOST=postgres
POSTGRES_DB=askhub
POSTGRES_USER=askhub
POSTGRES_PASSWORD=replace-with-local-password
ASKHUB_DOCKER_NETWORK=askhub-network

# ai-server schema only.
DB_SCHEMA=ai
TEST_DB_SCHEMA=ai_test

# Service-to-service authentication. Use a strong random value outside examples.
SERVICE_AUTH_ENABLED=true
SERVICE_AUTH_SECRET=replace-with-random-secret
SERVICE_AUTH_TIMESTAMP_TOLERANCE_SECONDS=300

# File storage (S3 only).
FILE_STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET=replace-with-s3-bucket
S3_REGION=ap-northeast-2
S3_PREFIX=ai-server/user-files
MAX_UPLOAD_BYTES=10485760
MAX_FILE_CONTEXT_BYTES=51200
MAX_FILES_PER_MESSAGE=5
MAX_HISTORY_MESSAGES=20

BACKEND_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
